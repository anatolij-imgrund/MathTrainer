<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:MathTrainer.Model"
        xmlns:local="clr-namespace:MathTrainer.View"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
        x:Class="MathTrainer.View.PasswordPromptDialog"
        Title="Eingang zum Eltern/Lehrer - Bereich."
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Width="450" Height="800" MinHeight="800">

    <StackPanel Spacing="10" Margin="20">
        <TextBlock Text="Passwort eingeben" FontSize="16" FontWeight="Medium"/>
        <TextBox Name="PasswordInputBox" PasswordChar="*" Watermark="Passwort" HorizontalAlignment="Stretch"/>
        <TextBlock Name="ErrorTextBlock" Foreground="Red" HorizontalAlignment="Center" IsVisible="False"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Button Name="OkButton" Content="OK" Click="OkButton_Click" IsDefault="True"/>
            <Button Name="CancelButton" Content="Ablehnen" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock Text="Passwort ändern" FontSize="16" FontWeight="Medium"/>
        
        <TextBlock Text="Neues Passwort:" Margin="0,5,0,0"/>
        <TextBox Name="NewPasswordTextBox" Watermark="Passwort" PasswordChar="*"/> 
        
        <TextBlock Text="Neues Passwort wiederholen:" Margin="0,5,0,0"/>
        <TextBox Name="ConfirmNewPasswordTextBox" Watermark="Passwort" PasswordChar="*"/>
        
        <Button Name="ChangePasswordButton" 
                Content="Änderung speichern" 
                Click="ChangePasswordButton_Click" 
                HorizontalAlignment="Center"
                Margin="0,10,0,0"/>

        <TextBlock Name="ChangePasswordStatusTextBlock" Margin="0,5,0,0"/>

    </StackPanel>

</Window>